# Supabase Configuration
# Get these values from your Supabase project settings
# Dashboard: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# IMPORTANT SECURITY NOTES:
# 1. The anon key is safe to expose in client-side code (VITE_ prefix makes it public)
# 2. NEVER commit your actual .env file to version control
# 3. ALWAYS enable Row Level Security (RLS) on all Supabase tables
# 4. NEVER expose the service_role key in client-side code
# 5. Set GROQ_API_KEY as a Supabase Edge Function secret, not as a VITE_ browser variable
# 6. Copy this file to .env and fill in your actual values

# API Configuration (for future backend)
# VITE_API_URL=http://localhost:3000/api

# Analytics (optional)
# VITE_GA_TRACKING_ID=your_google_analytics_id

# Payment Gateway (optional)
# VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key
